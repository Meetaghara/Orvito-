---
/**
 * Founder note: Hem's photo (public/images/founder.jpg, 4:5), the note in italic serif and a signature line.
 * The note is the website version of the client's words (src/data/site.ts) and still needs his approval.
 */
import { Picture } from 'astro:assets';
import { founder } from '../data/site';

const photos = import.meta.glob<{ default: ImageMetadata }>('../../public/images/*.jpg', { eager: true });
const photo = founder.photo ? photos[`../../public${founder.photo}`]?.default : undefined;
---

<section class="founder section" aria-labelledby="founder-title">
  <div class="container founder__inner">
    <div class="founder__photo" data-reveal>
      {
        photo ? (
          <Picture
            src={photo}
            formats={['avif', 'webp']}
            widths={[400, 640, 900]}
            sizes="(min-width: 48rem) 384px, 256px"
            alt={`${founder.name}, founder of ORVITO`}
            loading="lazy"
            decoding="async"
          />
        ) : (
          <span class="photo-placeholder">Founder photo</span>
        )
      }
    </div>
    <figure class="founder__note">
      <span class="eyebrow" id="founder-title">A note from the founder</span>
      <blockquote class="founder__quote" data-split>
        <p>“{founder.note}”</p>
      </blockquote>
      <figcaption class="founder__sign" data-reveal>
        <span class="founder__name">{founder.name}</span>
        <span class="founder__role">{founder.role}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .founder__inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  .founder__photo {
    aspect-ratio: 4 / 5;
    max-width: 24rem;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-placeholder-dark);
  }
  .founder__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .founder__note .eyebrow { margin-bottom: var(--space-5); }
  .founder__quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.75rem, 1.3rem + 1.9vw, 3rem);
    line-height: 1.18;
    color: var(--color-white);
    max-width: 30ch;
  }
  .founder__sign {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-6);
  }
  .founder__name {
    font-family: var(--font-serif);
    font-size: var(--text-h4);
    color: var(--color-white);
  }
  .founder__role {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  @media (min-width: 48rem) {
    .founder__inner { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: var(--space-9); }
  }
  @media (max-width: 47.99rem) {
    .founder__photo { max-width: 16rem; }
  }
</style>
