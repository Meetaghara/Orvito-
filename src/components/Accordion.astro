---
/**
 * FAQ accordion built on <details>, so it works without JavaScript and with the keyboard.
 * Opening one closes the others (shared `name`). The panel height animates where the browser
 * supports it (interpolate-size); elsewhere it opens instantly.
 */
import type { Faq } from '../data/faq';

interface Props {
  items: Faq[];
  name?: string;
  numbered?: boolean;
}
const { items, name = 'faq', numbered = true } = Astro.props;
---

<div class="accordion" data-stagger>
  {
    items.map((item, i) => (
      <details class="accordion__item" name={name} id={`faq-${item.id}`} data-stagger-item>
        <summary class="accordion__summary">
          {numbered && <span class="accordion__num">{String(i + 1).padStart(2, '0')}</span>}
          <span class="accordion__q">{item.question}</span>
          <span class="accordion__icon" aria-hidden="true" />
        </summary>
        <div class="accordion__panel">
          <p>
            {item.answer.map((seg) =>
              typeof seg === 'string' ? (
                seg
              ) : 'pending' in seg ? (
                <span class="pending">[{seg.pending}]</span>
              ) : (
                <a href={seg.href}>{seg.link}</a>
              )
            )}
          </p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .accordion { border-top: var(--border); }
  .accordion__item {
    border-bottom: var(--border);
    interpolate-size: allow-keywords;
  }
  .accordion__summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-5);
    cursor: pointer;
    list-style: none;
  }
  .accordion__summary::-webkit-details-marker { display: none; }
  .accordion__num {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }
  .accordion__q {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
    line-height: 1.15;
    color: var(--color-white);
  }
  /* Plus that turns into a minus */
  .accordion__icon {
    position: relative;
    width: 14px;
    height: 14px;
    align-self: center;
  }
  .accordion__icon::before,
  .accordion__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: var(--color-white);
  }
  .accordion__icon::after {
    transform: rotate(90deg);
    transition: transform 200ms var(--ease-out);
  }
  .accordion__item[open] .accordion__icon::after { transform: rotate(0deg); }

  .accordion__item::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 260ms var(--ease-out),
      content-visibility 260ms allow-discrete;
  }
  .accordion__item[open]::details-content { block-size: auto; }

  .accordion__panel {
    padding: 0 0 var(--space-5) calc(2ch + var(--space-4));
    max-width: 44rem;
    color: var(--color-text);
  }
  .accordion__panel a {
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (hover: hover) and (pointer: fine) {
    .accordion__summary:hover .accordion__q { color: var(--color-ivory); }
  }
  @media (prefers-reduced-motion: reduce) {
    .accordion__item::details-content,
    .accordion__icon::after { transition: none; }
  }
</style>
