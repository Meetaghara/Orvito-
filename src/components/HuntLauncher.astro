---
/**
 * Floating "Find the hidden bar · 50% off" button, bottom-right on every page (above the sticky
 * order bar on phones). It pops in after a moment, shows its label for a few seconds, then shrinks
 * to a round magnifier with a soft pulse; hover or keyboard focus opens the label again.
 *
 * On pages that have the game (Home, The Bar), HuntGame's delegated [data-hunt-open] handler opens
 * the dialog. Elsewhere the link goes to the home page with ?play=find-the-bar, which opens it there.
 * transition:persist keeps it across page changes, so it only pops in once per visit.
 */
import { findTheBar } from '../data/site';

const label = `Find the hidden bar · ${findTheBar.discountPercent}% off`;
---

<a
  href="/?play=find-the-bar"
  class="hunt-launcher"
  data-hunt-open
  data-hunt-launcher
  data-cursor="Play"
  aria-label={`${label} a Box of 12. Play the game.`}
  transition:persist="hunt-launcher"
>
  <span class="hunt-launcher__icon" aria-hidden="true">
    <svg viewBox="0 0 20 20" width="22" height="22">
      <circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.9" />
      <path d="M12.8 12.8 17 17" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
    </svg>
  </span>
  <span class="hunt-launcher__label" aria-hidden="true">{label}</span>
  <span class="hunt-launcher__badge" aria-hidden="true">{findTheBar.discountPercent}%</span>
</a>

<script>
  const SHOW_AFTER = 2500; // ms after the first page load
  const LABEL_FOR = 5000; // ms the label stays open after popping in

  function init() {
    const el = document.querySelector<HTMLElement>('[data-hunt-launcher]');
    if (!el || el.dataset.ready) return; // persisted across page changes: only pop in once
    el.dataset.ready = '1';
    window.setTimeout(() => {
      el.classList.add('is-in', 'is-open');
      window.setTimeout(() => el.classList.remove('is-open'), LABEL_FOR);
    }, SHOW_AFTER);
  }

  document.addEventListener('astro:page-load', init);
</script>

<style>
  .hunt-launcher {
    --size: 56px;
    position: fixed;
    right: var(--space-5);
    bottom: var(--space-5);
    z-index: 42; /* above the sticky order bar (40), below the menu (45) and header (50) */
    display: flex;
    flex-direction: row-reverse; /* icon stays on the right; the label grows to the left */
    align-items: center;
    height: var(--size);
    border-radius: 999px;
    background: var(--color-honey);
    color: #0b0b0b;
    text-decoration: none;
    box-shadow:
      0 12px 32px rgb(0 0 0 / 0.5),
      0 2px 6px rgb(0 0 0 / 0.3);
    opacity: 0;
    transform: translateY(16px) scale(0.6);
    pointer-events: none;
    transition:
      opacity 300ms var(--ease-out),
      transform 550ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .hunt-launcher:global(.is-in) {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .hunt-launcher__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: var(--size);
    height: var(--size);
  }

  .hunt-launcher__label {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition:
      max-width 450ms var(--ease-out),
      padding 450ms var(--ease-out);
  }
  .hunt-launcher:global(.is-open) .hunt-launcher__label,
  .hunt-launcher:focus-visible .hunt-launcher__label {
    max-width: 22rem;
    padding-left: var(--space-5);
  }
  @media (hover: hover) and (pointer: fine) {
    .hunt-launcher:hover .hunt-launcher__label {
      max-width: 22rem;
      padding-left: var(--space-5);
    }
  }

  /* Small "50%" tag on the round button; hidden while the label (which says it) is open */
  .hunt-launcher__badge {
    position: absolute;
    top: -6px;
    right: calc(var(--size) - 26px);
    padding: 2px 6px;
    border-radius: 999px;
    background: #0b0b0b;
    color: var(--color-honey);
    border: 1px solid var(--color-honey);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: var(--weight-medium);
    line-height: 1.3;
    transition: opacity 200ms var(--ease-out);
  }
  .hunt-launcher:global(.is-open) .hunt-launcher__badge,
  .hunt-launcher:focus-visible .hunt-launcher__badge { opacity: 0; }
  @media (hover: hover) and (pointer: fine) {
    .hunt-launcher:hover .hunt-launcher__badge { opacity: 0; }
  }

  /* Soft honey pulse around the round button */
  .hunt-launcher::before {
    content: '';
    position: absolute;
    right: 0;
    top: 0;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    border: 2px solid var(--color-honey);
    opacity: 0;
    pointer-events: none;
  }
  .hunt-launcher:global(.is-in):not(:global(.is-open))::before {
    animation: hunt-launcher-pulse 2.4s var(--ease-out) 600ms infinite;
  }
  @keyframes hunt-launcher-pulse {
    0% { transform: scale(1); opacity: 0.7; }
    70%, 100% { transform: scale(1.7); opacity: 0; }
  }

  .hunt-launcher:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  /* Out of the way while the game or the phone menu is open */
  :global(html.hunt-open) .hunt-launcher,
  :global(html.menu-open) .hunt-launcher {
    opacity: 0;
    transform: scale(0.6);
    pointer-events: none;
  }

  /* Phones and small tablets: sit above the sticky "Order on WhatsApp" bar */
  @media (max-width: 56.24rem) {
    .hunt-launcher {
      --size: 52px;
      right: var(--space-3);
      bottom: calc(var(--sticky-cta-height) + env(safe-area-inset-bottom) + var(--space-3));
    }
    /* The bulk page hides the sticky bar, so drop to the corner there */
    :global(html:has(form[data-bulk-form])) .hunt-launcher {
      bottom: calc(env(safe-area-inset-bottom) + var(--space-4));
    }
    .hunt-launcher__label { font-size: 0.6875rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hunt-launcher { transition: opacity 200ms linear; transform: none; }
    .hunt-launcher::before { animation: none !important; }
    .hunt-launcher__label { transition: none; }
  }
</style>
